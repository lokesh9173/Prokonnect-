# Server Environment ('development' or 'production')
NODE_ENV=production
PORT=5001

# MongoDB Connection String (Local Docker container or MongoDB Atlas Cluster)
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/prokonnect?retryWrites=true&w=majority
# Example Local: mongodb://mongo:27017/prokonnect
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/prokonnect?retryWrites=true&w=majority

# Authentication Secret (MANDATORY: Minimum 32 characters in production)
# Generate a cryptographically secure key in your terminal: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# AI Assistant API Key (Optional: Groq Llama 3.1)
# If left empty, automated fallback Q&A will respond to platform questions
GROQ_API_KEY=gsk_your_groq_api_key_here

# Production Frontend Domain (MANDATORY for CORS in production, comma-separated if multiple)
# In production, localhost origins are blocked. Example: https://app.prokonnect.com,https://staging.prokonnect.com
CLIENT_URL=https://staging.prokonnect.com

# Optional SMTP Email Configuration (For password reset delivery)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_specific_password
# FROM_NAME=ProKonnect
# FROM_EMAIL=noreply@prokonnect.com
