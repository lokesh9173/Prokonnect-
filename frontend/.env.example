# ==========================================
# ProKonnect Frontend Environment Variables
# ==========================================

# Backend API Base URL
# - Leave empty if deploying backend and frontend together on the same domain or in local dev.
# - If deploying frontend to Vercel/Netlify and backend to Render/Railway/Fly.io, set this:
# Example: VITE_API_URL=https://prokonnect-api.onrender.com
VITE_API_URL=
